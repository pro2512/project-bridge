{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1200px"
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "name": "Serif",
          "slug": "serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Base",
          "size": "1rem",
          "slug": "base"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "XL",
          "size": "1.75rem",
          "slug": "xl"
        },
        {
          "name": "XXL",
          "size": "2.25rem",
          "slug": "xxl"
        }
      ],
      "lineHeight": true
    },
    "spacing": {
      "units": ["px", "rem", "em", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#212529"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--system-sans)",
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2rem, 4vw, 2.75rem)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.75rem, 3vw, 2.25rem)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.5rem, 2.6vw, 1.875rem)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "clamp(1.25rem, 2vw, 1.5rem)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "1rem",
          "textTransform": "uppercase",
          "letterSpacing": "0.04em"
        }
      },
      "paragraph": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "lineHeight": "1.7"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "1rem"
          }
        }
      }
    }
  }
}
